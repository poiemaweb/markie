{
  "name": "markie",
  "version": "0.2.0",
  "private": true,
  "description": "마크다운 텍스트를 즉시 예쁘게 렌더링하는 초경량 컴패니언",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/markie/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "markdown-it": "^14.0.0",
    "mermaid": "^11.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^13.0.7",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "~4.5.2",
    "vitest": "~0.34.6"
  },
  "optionalDependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
