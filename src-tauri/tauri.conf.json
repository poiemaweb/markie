{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markie",
  "version": "0.1.0",
  "identifier": "com.markie.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Markie",
        "label": "main",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "마크다운 텍스트를 즉시 예쁘게 렌더링",
    "longDescription": "마크다운 텍스트를 전역 단축키 한 번으로 즉시 예쁘게 렌더링해주는 경량 컴패니언."
  },
  "plugins": {}
}
