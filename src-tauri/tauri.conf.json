{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Preview Companion",
  "version": "0.1.0",
  "identifier": "com.markdownpreview.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Preview",
        "label": "main",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "메신저에서 받은 깨진 마크다운을 즉시 예쁘게 렌더링",
    "longDescription": "Discord에서 받은 AI 답변의 훼손된 마크다운을 전역 단축키 한 번으로 복원해 보여주는 경량 컴패니언."
  },
  "plugins": {}
}
